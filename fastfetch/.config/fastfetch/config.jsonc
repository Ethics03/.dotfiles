{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "color": {
            "1": "#89b4fa",
            "2": "#89b4fa"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#89b4fa",
            "title": "#89b4fa",
            "output": "#cdd6f4",
            "separator": "#585b70"
        },
        "key": {
            "width": 11
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "outputColor": "#585b70"
        },
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "break",
        {
            "type": "wm",
            "key": "Desktop"
        },
        "shell",
        "terminal",
        "break",
        {
            "type": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "format": "{name}"
        },
        "memory",
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/",
            "format": "{size-used} / {size-total}"
        },
        {
            "type": "battery",
            "key": "Battery"
        }
    ]
}
